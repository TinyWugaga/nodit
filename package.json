{
  "name": "nodit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --clear-screen=false server/cli.ts examples/demo --port 4319 --dev-origin http://localhost:5173",
    "nodit": "tsx server/cli.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "bin": {
    "nodit": "bin/nodit.mjs"
  },
  "engines": {
    "node": ">=22.22"
  },
  "description": "把專案 docs/ 裡的 ADR、Milestone、Task 畫成可編輯關聯圖的本地工具"
}
