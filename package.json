{
  "name": "@tinywugaga/nodit",
  "version": "0.3.0",
  "type": "module",
  "description": "把專案 docs/ 裡的 ADR、Milestone、Task 畫成可編輯關聯圖的本地工具",
  "license": "MIT",
  "homepage": "https://github.com/TinyWugaga/nodit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyWugaga/nodit.git"
  },
  "bugs": {
    "url": "https://github.com/TinyWugaga/nodit/issues"
  },
  "bin": {
    "nodit": "bin/nodit.mjs"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --clear-screen=false server/cli.ts examples/demo --port 4319 --dev-origin http://localhost:5173",
    "nodit": "tsx server/cli.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:server": "esbuild server/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/cli.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
